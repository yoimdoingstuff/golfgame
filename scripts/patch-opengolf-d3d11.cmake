if(NOT DEFINED OPENGOLF_DIR)
    message(FATAL_ERROR "OPENGOLF_DIR is required.")
endif()

set(_cmake_file "${OPENGOLF_DIR}/CMakeLists.txt")
if(NOT EXISTS "${_cmake_file}")
    message(FATAL_ERROR "Open-Golf CMakeLists.txt was not found: ${_cmake_file}")
endif()

file(READ "${_cmake_file}" _contents)
string(FIND "${_contents}" "add_compile_definitions(SOKOL_D3D11)" _d3d_pos)
if(NOT _d3d_pos EQUAL -1)
    message(STATUS "Open-Golf Windows D3D11 backend is already selected.")
    return()
endif()

string(FIND "${_contents}" "if(CMAKE_SYSTEM_NAME STREQUAL Windows)" _windows_pos)
string(FIND "${_contents}" "add_compile_definitions(SOKOL_GLCORE33)" _gl_pos)
if(_windows_pos EQUAL -1 OR _gl_pos LESS _windows_pos)
    message(FATAL_ERROR "Could not find the expected Open-Golf Windows OpenGL backend definition.")
endif()

set(_old "add_compile_definitions(SOKOL_GLCORE33)")
set(_new "add_compile_definitions(SOKOL_D3D11)")
string(LENGTH "${_old}" _old_length)
string(LENGTH "${_contents}" _contents_length)
math(EXPR _suffix_start "${_gl_pos} + ${_old_length}")
math(EXPR _suffix_length "${_contents_length} - ${_suffix_start}")
string(SUBSTRING "${_contents}" 0 ${_gl_pos} _prefix)
string(SUBSTRING "${_contents}" ${_suffix_start} ${_suffix_length} _suffix)
set(_patched "${_prefix}${_new}${_suffix}")
file(WRITE "${_cmake_file}" "${_patched}")
message(STATUS "Patched pinned Open-Golf Windows backend to Sokol D3D11.")
